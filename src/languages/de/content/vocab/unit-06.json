[
  {
    "id": "de-a1-0230",
    "term": "der Montag",
    "meaning": {
      "es": "el lunes"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Am Montag arbeite ich.",
        "translation": "El lunes trabajo."
      }
    ],
    "notes": "Todos los días de la semana son masculinos (der). 'El lunes' se dice am Montag; 'los lunes', montags (en minúscula).",
    "tags": [
      "tiempo",
      "días"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Montage"
    }
  },
  {
