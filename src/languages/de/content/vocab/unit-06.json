  },
  {
    "id": "de-a1-0237",
    "term": "die Uhr",
    "meaning": {
      "es": "el reloj; la hora (en 'a las … horas')"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Es ist acht Uhr.",
        "translation": "Son las ocho."
      },
      {
        "text": "Der Kurs beginnt um neun Uhr.",
        "translation": "El curso empieza a las nueve."
      }
    ],
    "notes": "Femenino: die. Plural: die Uhren. 'A las ocho' es um acht Uhr (con um). Para la duración se usa die Stunde: zwei Stunden.",
    "tags": [
      "tiempo",
      "hora"
    ],
    "level": "A1",
    "extra": {
      "gender": "f",
      "plural": "die Uhren"
    }
  },
  {
    "id": "de-a1-0238",
    "term": "Wie spät ist es?",
    "meaning": {
      "es": "¿Qué hora es?"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Wie spät ist es? Es ist zehn nach drei.",
        "translation": "¿Qué hora es? Son las tres y diez."
      }
    ],
    "notes": "Literalmente '¿qué tan tarde es?'. También: Wie viel Uhr ist es? Respuesta: Es ist …",
    "tags": [
      "tiempo",
      "hora",
      "expresiones"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0239",
    "term": "halb",
    "meaning": {
      "es": "media (al decir la hora)"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Es ist halb acht.",
        "translation": "Son las siete y media."
      }
    ],
    "notes": "¡Trampa! halb acht = las 7:30 (media hora antes de las ocho), no las 8:30. Se cuenta hacia la hora siguiente.",
    "tags": [
      "tiempo",
      "hora"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0240",
    "term": "aufstehen",
    "meaning": {
      "es": "levantarse"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich stehe um sechs Uhr auf.",
        "translation": "Me levanto a las seis."
      },
      {
        "text": "Wann stehst du auf?",
        "translation": "¿A qué hora te levantas?"
      }
    ],
    "notes": "Separable: el prefijo auf va al final de la frase. En alemán no es reflexivo: Ich stehe auf (sin 'me').",
    "tags": [
      "verbos",
      "rutina",
      "separable"
    ],
    "level": "A1",
    "extra": {
      "present3": "er steht auf",
      "perfekt": "ist aufgestanden",
      "separable": true
    }
  },
  {
    "id": "de-a1-0241",
    "term": "frühstücken",
    "meaning": {
      "es": "desayunar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir frühstücken um sieben Uhr.",
        "translation": "Desayunamos a las siete."
      }
    ],
    "notes": "¡No es separable! Aunque parece compuesto: Ich frühstücke (nunca 'Ich stücke früh').",
    "tags": [
      "verbos",
      "rutina",
      "comida"
    ],
    "level": "A1",
    "extra": {
      "present3": "er frühstückt",
      "perfekt": "hat gefrühstückt"
    }
  },
  {
    "id": "de-a1-0242",
    "term": "das Frühstück",
    "meaning": {
      "es": "el desayuno"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Das Frühstück ist fertig.",
        "translation": "El desayuno está listo."
      }
    ],
    "notes": "Neutro porque termina en das Stück. Plural: die Frühstücke. Literalmente 'pieza temprana'.",
