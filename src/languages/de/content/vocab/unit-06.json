  {
    "id": "de-a1-0254",
    "term": "kochen",
    "meaning": {
      "es": "cocinar; hervir"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Mein Vater kocht sehr gut.",
        "translation": "Mi papá cocina muy bien."
      }
    ],
    "notes": "Regular: ich koche, du kochst. ch tras o suena fuerte, como la j española: 'kójen'.",
