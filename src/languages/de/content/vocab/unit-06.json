  {
    "id": "de-a1-0249",
    "term": "morgens",
    "meaning": {
      "es": "por la mañana, en las mañanas"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Morgens trinke ich Kaffee.",
        "translation": "Por las mañanas tomo café."
      }
    ],
    "notes": "En minúscula y con -s: indica costumbre. Igual: mittags, nachmittags, abends, nachts. Si va al inicio, el verbo va en segundo lugar.",
    "tags": [
      "tiempo",
      "rutina"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0250",
    "term": "das Hobby",
    "meaning": {
      "es": "el hobby, el pasatiempo"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Was ist dein Hobby?",
        "translation": "¿Cuál es tu pasatiempo?"
      }
    ],
    "notes": "Neutro: das. Plural: die Hobbys (con -ys, no -ies como en inglés).",
