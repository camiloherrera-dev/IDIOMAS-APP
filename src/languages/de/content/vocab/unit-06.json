      "es": "nadar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir schwimmen am Sonntag.",
        "translation": "Nadamos el domingo."
      }
    ],
    "notes": "Regular en presente: ich schwimme, du schwimmst. 'Ir a nadar': schwimmen gehen.",
