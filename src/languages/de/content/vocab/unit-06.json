    "term": "aufräumen",
    "meaning": {
      "es": "ordenar, arreglar (un espacio)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich räume mein Zimmer auf.",
        "translation": "Ordeno mi cuarto."
      }
    ],
    "notes": "Separable: ich räume auf. Ojo: aufstehen y aufräumen tienen el mismo prefijo, pero distinto significado.",
