  {
    "id": "de-a1-0236",
    "term": "der Sonntag",
    "meaning": {
      "es": "el domingo"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Am Sonntag sind die Supermärkte zu.",
        "translation": "El domingo los supermercados están cerrados."
      }
    ],
    "notes": "Masculino: der. Plural: die Sonntage. En Alemania casi todas las tiendas cierran el domingo.",
    "tags": [
      "tiempo",
      "días"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
