    }
  },
  {
    "id": "de-a1-0251",
    "term": "gern",
    "meaning": {
      "es": "con gusto; (verbo + gern) gustar hacer algo"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Ich koche gern.",
        "translation": "Me gusta cocinar."
      },
      {
        "text": "Spielst du gern Fußball?",
        "translation": "¿Te gusta jugar fútbol?"
      }
    ],
    "notes": "No hay verbo 'gustar': se usa verbo + gern. Ich lese gern = me gusta leer. Negación: nicht gern. También se escribe gerne.",
    "tags": [
      "tiempo-libre",
      "gustos"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0252",
    "term": "lesen",
    "meaning": {
      "es": "leer"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich lese gern Bücher.",
        "translation": "Me gusta leer libros."
      },
      {
        "text": "Liest du gern?",
        "translation": "¿Te gusta leer?"
      }
    ],
    "notes": "Cambio de vocal e → ie: du liest, er liest (du y er son iguales).",
    "tags": [
      "verbos",
      "tiempo-libre",
      "cambio-vocal"
    ],
    "level": "A1",
    "extra": {
      "present3": "er liest",
      "perfekt": "hat gelesen"
    }
  },
