    }
  },
  {
    "id": "de-a1-0243",
    "term": "anfangen",
    "meaning": {
      "es": "empezar, comenzar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Die Arbeit fängt um acht Uhr an.",
        "translation": "El trabajo empieza a las ocho."
      },
      {
        "text": "Wann fängst du an?",
        "translation": "¿Cuándo empiezas?"
      }
    ],
    "notes": "Separable y con cambio de vocal a → ä: ich fange an, du fängst an, er fängt an. Sinónimo no separable: beginnen.",
    "tags": [
      "verbos",
      "rutina",
      "separable",
      "cambio-vocal"
    ],
    "level": "A1",
    "extra": {
      "present3": "er fängt an",
      "perfekt": "hat angefangen",
      "separable": true
    }
  },
  {
    "id": "de-a1-0244",
    "term": "einkaufen",
    "meaning": {
      "es": "hacer las compras, mercar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Am Samstag kaufe ich ein.",
        "translation": "El sábado hago las compras."
      },
      {
        "text": "Kaufst du heute ein?",
        "translation": "¿Vas a mercar hoy?"
      }
    ],
    "notes": "Separable: ich kaufe ein. Sin objeto significa 'hacer mercado'. Con objeto concreto se usa más kaufen: Ich kaufe Brot.",
    "tags": [
      "verbos",
      "rutina",
      "separable",
      "compras"
    ],
    "level": "A1",
    "extra": {
      "present3": "er kauft ein",
      "perfekt": "hat eingekauft",
      "separable": true
    }
  },
  {
    "id": "de-a1-0245",
    "term": "anrufen",
    "meaning": {
      "es": "llamar (por teléfono)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich rufe meine Mutter an.",
        "translation": "Llamo a mi mamá."
      },
      {
        "text": "Rufst du heute an?",
        "translation": "¿Llamas hoy?"
      }
    ],
    "notes": "Separable y con acusativo: Ich rufe dich an (te llamo). No lleva preposición como el 'a' español.",
    "tags": [
      "verbos",
      "rutina",
      "separable"
    ],
    "level": "A1",
    "extra": {
      "present3": "er ruft an",
      "perfekt": "hat angerufen",
      "separable": true
    }
  },
  {
    "id": "de-a1-0246",
    "term": "fernsehen",
    "meaning": {
      "es": "ver televisión"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Abends sehe ich fern.",
        "translation": "Por la noche veo televisión."
      },
      {
        "text": "Siehst du oft fern?",
        "translation": "¿Ves televisión a menudo?"
      }
    ],
    "notes": "Separable y con cambio de vocal e → ie: du siehst fern, er sieht fern. El aparato es der Fernseher.",
    "tags": [
      "verbos",
      "rutina",
      "separable",
      "cambio-vocal"
    ],
    "level": "A1",
    "extra": {
      "present3": "er sieht fern",
      "perfekt": "hat ferngesehen",
      "separable": true
    }
  },
  {
