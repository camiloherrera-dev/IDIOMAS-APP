  {
    "id": "de-a1-0226",
    "term": "bestellen",
    "meaning": {
      "es": "pedir (en un restaurante), encargar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir möchten bestellen.",
        "translation": "Quisiéramos pedir."
      },
      {
        "text": "Er bestellt eine Suppe.",
        "translation": "Él pide una sopa."
      }
    ],
    "notes": "No es separable (be- nunca se separa). Para 'pedir' un favor se usa otro verbo (bitten).",
    "tags": [
      "verbos",
      "restaurante"
    ],
    "level": "A1",
    "extra": {
      "present3": "er bestellt",
      "perfekt": "hat bestellt"
    }
  },
  {
    "id": "de-a1-0227",
    "term": "bezahlen",
    "meaning": {
      "es": "pagar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich möchte bezahlen.",
        "translation": "Quisiera pagar."
      },
      {
        "text": "Zahlen Sie zusammen oder getrennt?",
        "translation": "¿Pagan juntos o por separado?"
      }
    ],
    "notes": "No es separable. En el restaurante también se oye zahlen, sin be-. Pregunta típica del mesero: zusammen oder getrennt?",
    "tags": [
      "verbos",
      "restaurante"
    ],
    "level": "A1",
    "extra": {
      "present3": "er bezahlt",
      "perfekt": "hat bezahlt"
    }
  },
  {
    "id": "de-a1-0228",
