      "es": "saber (bien o mal), estar rico"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Schmeckt die Suppe?",
        "translation": "¿Está rica la sopa?"
      },
      {
        "text": "Der Kuchen schmeckt gut.",
        "translation": "La torta sabe bien."
      }
    ],
    "notes": "El sujeto es la comida: Die Suppe schmeckt (sie schmecken en plural). Lecker significa 'rico, delicioso'.",
    "tags": [
      "verbos",
      "restaurante"
    ],
    "level": "A1",
    "extra": {
      "present3": "es schmeckt",
      "perfekt": "hat geschmeckt"
    }
  },
  {
    "id": "de-a1-0229",
    "term": "Zahlen, bitte!",
    "meaning": {
      "es": "¡La cuenta, por favor!"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Entschuldigung, zahlen, bitte!",
        "translation": "Disculpe, ¡la cuenta, por favor!"
      }
    ],
    "notes": "Forma corta y normal de pedir la cuenta. También: Die Rechnung, bitte! o Ich möchte bitte bezahlen.",
