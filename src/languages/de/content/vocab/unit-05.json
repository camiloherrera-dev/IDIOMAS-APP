  {
    "id": "de-a1-0217",
    "term": "der Euro",
    "meaning": {
      "es": "el euro"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Das kostet fünf Euro.",
        "translation": "Eso cuesta cinco euros."
      }
    ],
    "notes": "Masculino: der. Con números no se pone plural: zehn Euro. 'Eu' suena 'oi': 'oiro'. 2,50 € se lee 'zwei Euro fünfzig'.",
    "tags": [
      "compras",
      "dinero"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Euros"
    }
  },
  {
