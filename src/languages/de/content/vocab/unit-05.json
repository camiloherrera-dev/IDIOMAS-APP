  {
    "id": "de-a1-0205",
    "term": "die Milch",
    "meaning": {
      "es": "la leche"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Trinkst du Kaffee mit Milch?",
        "translation": "¿Tomas café con leche?"
      }
    ],
    "notes": "Femenino: die. Sin plural. La ch tras l o i suena suave, como un susurro: 'milj'.",
    "tags": [
      "comida",
      "bebidas"
    ],
    "level": "A1",
    "extra": {
      "gender": "f",
      "plural": "sin plural"
    }
  },
  {
    "id": "de-a1-0206",
    "term": "das Wasser",
    "meaning": {
      "es": "el agua"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Ich trinke viel Wasser.",
        "translation": "Tomo mucha agua."
      }
    ],
    "notes": "Neutro: das. Sin plural en el uso diario. La W suena como una v suave: 'vasa'.",
    "tags": [
      "bebidas"
    ],
    "level": "A1",
    "extra": {
      "gender": "n",
      "plural": "sin plural"
    }
  },
  {
    "id": "de-a1-0207",
    "term": "der Kaffee",
    "meaning": {
      "es": "el café (bebida)"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Ich trinke keinen Kaffee.",
        "translation": "No tomo café."
      }
    ],
    "notes": "Masculino: der. Plural: die Kaffees. En acusativo: einen Kaffee / keinen Kaffee. El local es das Café.",
    "tags": [
      "bebidas"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Kaffees"
    }
  },
  {
    "id": "de-a1-0208",
    "term": "essen",
    "meaning": {
      "es": "comer"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir essen Brot mit Käse.",
        "translation": "Comemos pan con queso."
      },
      {
        "text": "Isst du Fleisch?",
        "translation": "¿Comes carne?"
      }
    ],
    "notes": "Cambio de vocal e → i: ich esse, du isst, er isst. Con du y er la forma es la misma: isst.",
    "tags": [
      "verbos",
      "comida"
    ],
    "level": "A1",
    "extra": {
      "present3": "er isst",
      "perfekt": "hat gegessen"
    }
  },
  {
    "id": "de-a1-0209",
    "term": "trinken",
    "meaning": {
      "es": "beber, tomar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Was trinkst du?",
        "translation": "¿Qué tomas?"
      },
      {
        "text": "Er trinkt einen Kaffee.",
        "translation": "Él se toma un café."
      }
    ],
    "notes": "Regular en presente: ich trinke, du trinkst, er trinkt. Para bebidas no se usa 'nehmen' como 'tomar' salvo al pedir.",
    "tags": [
      "verbos",
      "bebidas"
    ],
    "level": "A1",
    "extra": {
      "present3": "er trinkt",
      "perfekt": "hat getrunken"
    }
  },
  {
    "id": "de-a1-0210",
    "term": "der Supermarkt",
    "meaning": {
      "es": "el supermercado"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Der Supermarkt ist neu.",
        "translation": "El supermercado es nuevo."
      }
    ],
    "notes": "Masculino porque termina en der Markt. Plural: die Supermärkte.",
