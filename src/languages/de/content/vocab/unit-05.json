    "meaning": {
      "es": "caro"
    },
    "pos": "adjetivo",
    "examples": [
      {
        "text": "Der Käse ist sehr teuer.",
        "translation": "El queso es muy caro."
      }
    ],
    "notes": "Contrario: billig. 'Eu' suena 'oi': 'tóier'.",
