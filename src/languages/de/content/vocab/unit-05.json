    "term": "der Fisch",
    "meaning": {
      "es": "el pescado; el pez"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Heute essen wir Fisch.",
        "translation": "Hoy comemos pescado."
      }
    ],
    "notes": "Masculino: der. Plural: die Fische. Una sola palabra para 'pez' y 'pescado'. sch suena como 'sh'.",
    "tags": [
      "comida"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Fische"
    }
