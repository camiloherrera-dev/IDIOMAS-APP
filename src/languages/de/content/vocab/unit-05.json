  {
    "id": "de-a1-0211",
    "term": "kaufen",
    "meaning": {
      "es": "comprar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich kaufe Milch und Brot.",
        "translation": "Compro leche y pan."
      },
      {
        "text": "Was kaufst du?",
        "translation": "¿Qué compras?"
      }
    ],
    "notes": "Regular: ich kaufe, du kaufst, er kauft. Lleva acusativo: Ich kaufe einen Apfel.",
    "tags": [
      "verbos",
      "compras"
    ],
    "level": "A1",
    "extra": {
      "present3": "er kauft",
      "perfekt": "hat gekauft"
    }
  },
  {
    "id": "de-a1-0212",
    "term": "kosten",
    "meaning": {
      "es": "costar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wie viel kostet das?",
        "translation": "¿Cuánto cuesta eso?"
      },
      {
        "text": "Die Äpfel kosten zwei Euro.",
        "translation": "Las manzanas cuestan dos euros."
      }
    ],
    "notes": "Casi siempre en tercera persona: es kostet, sie kosten. Tras -t se añade e: kostet.",
    "tags": [
      "verbos",
      "compras"
    ],
    "level": "A1",
    "extra": {
      "present3": "es kostet",
      "perfekt": "hat gekostet"
    }
  },
  {
    "id": "de-a1-0213",
    "term": "nehmen",
    "meaning": {
      "es": "tomar, coger; llevarse (al comprar o pedir)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich nehme ein Kilo Äpfel.",
        "translation": "Me llevo un kilo de manzanas."
      },
      {
        "text": "Was nimmst du?",
        "translation": "¿Qué vas a pedir?"
      }
    ],
    "notes": "Cambio de vocal e → i y además doble m: ich nehme, du nimmst, er nimmt. Muy usado al comprar y al pedir comida.",
    "tags": [
      "verbos",
      "compras",
      "cambio-vocal"
    ],
    "level": "A1",
    "extra": {
      "present3": "er nimmt",
      "perfekt": "hat genommen"
    }
  },
  {
    "id": "de-a1-0214",
    "term": "möchten",
    "meaning": {
      "es": "querer, desear (cortés)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich möchte eine Flasche Wasser.",
        "translation": "Quisiera una botella de agua."
      },
      {
        "text": "Möchtest du einen Kaffee?",
        "translation": "¿Quieres un café?"
      }
    ],
    "notes": "Forma cortés para pedir: ich möchte, du möchtest, er möchte (sin -t en er). Con otro verbo, este va al final: Ich möchte Käse kaufen.",
    "tags": [
      "verbos",
      "compras",
      "cortesía"
    ],
    "level": "A1",
    "extra": {
      "present3": "er möchte"
    }
  },
  {
