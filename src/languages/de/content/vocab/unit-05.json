  {
    "id": "de-a1-0203",
    "term": "das Fleisch",
    "meaning": {
      "es": "la carne"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Ich esse kein Fleisch.",
        "translation": "No como carne."
      }
    ],
    "notes": "Neutro: das. Sin plural. Para negarlo se usa kein (sin artículo): Ich esse kein Fleisch.",
