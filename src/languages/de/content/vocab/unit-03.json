[
  {
    "id": "de-a1-0061",
    "term": "die Familie",
    "meaning": {
      "es": "la familia"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Das ist meine Familie.",
        "translation": "Esta es mi familia."
      }
    ],
    "notes": "Se acentúa en \"mi\": fa-MI-li-e. La terminación -ie se pronuncia en dos sílabas.",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "f",
      "plural": "die Familien"
    }
  },
  {
    "id": "de-a1-0062",
    "term": "der Vater",
    "meaning": {
      "es": "el padre, el papá"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Mein Vater heißt Jorge.",
        "translation": "Mi papá se llama Jorge."
      }
    ],
    "notes": "La v suena como f: \"fáter\". Coloquial: der Papa.",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Väter"
    }
  },
  {
    "id": "de-a1-0063",
    "term": "die Mutter",
    "meaning": {
      "es": "la madre, la mamá"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Meine Mutter wohnt in Cali.",
        "translation": "Mi mamá vive en Cali."
      }
    ],
    "notes": "Coloquial: die Mama. Plural con umlaut: die Mütter.",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "f",
      "plural": "die Mütter"
    }
  },
  {
    "id": "de-a1-0064",
    "term": "die Eltern",
    "meaning": {
      "es": "los padres (papá y mamá)"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Meine Eltern wohnen in Bogotá.",
        "translation": "Mis papás viven en Bogotá."
      }
    ],
    "notes": "Solo existe en plural. Trampa: \"los padres\" (papá y mamá) es die Eltern, no die Väter (varios papás).",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "pl",
      "plural": "solo plural"
    }
  },
  {
    "id": "de-a1-0065",
    "term": "der Bruder",
    "meaning": {
      "es": "el hermano"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Mein Bruder ist zwanzig.",
        "translation": "Mi hermano tiene veinte años."
      }
    ],
    "notes": "Plural con umlaut: die Brüder.",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "m",
      "plural": "die Brüder"
    }
  },
  {
    "id": "de-a1-0066",
    "term": "die Schwester",
    "meaning": {
      "es": "la hermana"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Das ist meine Schwester Laura.",
        "translation": "Esta es mi hermana Laura."
      }
    ],
    "notes": "Plural: die Schwestern. Ojo con la pronunciación: sch suena como \"sh\".",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "f",
      "plural": "die Schwestern"
    }
  },
  {
    "id": "de-a1-0067",
    "term": "die Geschwister",
    "meaning": {
      "es": "los hermanos (hermanos y hermanas)"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Meine Geschwister wohnen in Medellín.",
        "translation": "Mis hermanos viven en Medellín."
      }
    ],
    "notes": "Solo plural. \"Hermanos\" en sentido general (sin distinguir hombre o mujer) es Geschwister, no Brüder.",
    "tags": [
      "familia"
    ],
    "level": "A1",
    "extra": {
      "gender": "pl",
      "plural": "solo plural"
    }
  },
  {
