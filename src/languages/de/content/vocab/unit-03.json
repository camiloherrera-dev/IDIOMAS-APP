    "term": "die Tochter",
    "meaning": {
      "es": "la hija"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Seine Tochter ist zehn.",
        "translation": "Su hija (de él) tiene diez años."
      }
    ],
    "notes": "Plural con umlaut: die Töchter.",
    "tags": [
      "familia"
    ],
