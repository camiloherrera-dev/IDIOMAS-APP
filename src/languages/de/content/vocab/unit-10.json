  {
    "id": "de-a2-0077",
    "term": "wehtun",
    "meaning": {
      "es": "doler"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Mir tut der Bauch weh.",
        "translation": "Me duele la barriga."
      },
      {
        "text": "Tun dir die Füße weh?",
        "translation": "¿Te duelen los pies?"
      }
    ],
    "notes": "La persona va en dativo (mir, dir, ihm, ihr…). El verbo concuerda con la parte del cuerpo: der Kopf tut weh, die Augen tun weh.",
    "tags": [
      "salud",
      "verbos",
      "irregular",
      "separable",
      "dativo"
    ],
    "level": "A2",
    "extra": {
      "present3": "es tut weh",
      "perfekt": "hat wehgetan",
      "praeteritum": "tat weh",
      "separable": true
    }
  },
  {
    "id": "de-a2-0078",
    "term": "sich fühlen",
    "meaning": {
      "es": "sentirse"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich fühle mich nicht gut.",
        "translation": "No me siento bien."
      },
      {
        "text": "Wie fühlen Sie sich heute?",
        "translation": "¿Cómo se siente hoy?"
      }
    ],
    "notes": "Reflexivo con acusativo: ich fühle mich, du fühlst dich, er fühlt sich.",
