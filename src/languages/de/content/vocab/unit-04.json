  {
    "id": "de-a1-0113",
    "term": "suchen",
    "meaning": {
      "es": "buscar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich suche den Schlüssel.",
        "translation": "Busco la llave."
      },
      {
        "text": "Wir suchen eine Wohnung.",
        "translation": "Buscamos un apartamento."
      }
    ],
    "notes": "Sin preposición: suchen + acusativo (buscar algo).",
    "tags": [
      "casa"
    ],
    "level": "A1",
    "extra": {
      "present3": "er sucht",
      "perfekt": "hat gesucht"
    }
  },
  {
    "id": "de-a1-0114",
    "term": "kein",
    "meaning": {
      "es": "ningún, ninguna; no (un, una)"
    },
    "pos": "artículo",
    "examples": [
      {
        "text": "Ich habe keinen Fernseher.",
        "translation": "No tengo televisor."
      },
      {
        "text": "Das ist kein Stuhl.",
        "translation": "Eso no es una silla."
      }
    ],
    "notes": "Artículo negativo: niega sustantivos que llevarían ein o ningún artículo. Se declina como ein: keinen en masculino acusativo.",
    "tags": [
      "casa"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0115",
    "term": "nicht",
    "meaning": {
      "es": "no"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Der Schrank ist nicht neu.",
        "translation": "El clóset no es nuevo."
      }
    ],
    "notes": "Niega verbos, adjetivos y sustantivos con artículo definido. Para sustantivos con ein o sin artículo se usa kein.",
    "tags": [
      "casa"
    ],
    "level": "A1"
  },
  {
    "id": "de-a1-0116",
    "term": "es gibt",
    "meaning": {
      "es": "hay"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Es gibt einen Tisch und zwei Stühle.",
        "translation": "Hay una mesa y dos sillas."
      }
    ],
    "notes": "Va siempre con acusativo: Es gibt einen Balkon. Negación: Es gibt keinen Balkon.",
    "tags": [
      "casa"
    ],
    "level": "A1"
  },
