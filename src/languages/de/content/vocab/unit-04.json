  {
    "id": "de-a1-0111",
    "term": "haben",
    "meaning": {
      "es": "tener"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir haben ein Haus.",
        "translation": "Tenemos una casa."
      },
      {
        "text": "Hast du einen Fernseher?",
        "translation": "¿Tienes televisor?"
      }
    ],
    "notes": "Irregular: du hast, er hat. Lleva complemento en acusativo: Ich habe einen Bruder.",
    "tags": [
      "casa"
    ],
    "level": "A1",
    "extra": {
      "present3": "er hat",
      "perfekt": "hat gehabt"
    }
  },
  {
    "id": "de-a1-0112",
    "term": "brauchen",
    "meaning": {
      "es": "necesitar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich brauche einen Stuhl.",
        "translation": "Necesito una silla."
      },
      {
        "text": "Brauchst du das Handy?",
        "translation": "¿Necesitas el celular?"
      }
    ],
    "notes": "Lleva acusativo. au suena como en \"aula\".",
    "tags": [
      "casa"
    ],
    "level": "A1",
    "extra": {
      "present3": "er braucht",
      "perfekt": "hat gebraucht"
