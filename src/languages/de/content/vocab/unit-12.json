[
  {
    "id": "de-a2-0233",
    "term": "die Hose",
    "meaning": {
      "es": "el pantalón"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Die Hose ist zu eng.",
        "translation": "El pantalón está demasiado apretado."
      }
