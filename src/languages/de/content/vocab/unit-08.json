      "pasado",
      "verbos",
      "irregular",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er steigt um",
      "perfekt": "ist umgestiegen",
      "praeteritum": "stieg um",
      "separable": true
    }
  },
  {
    "id": "de-a2-0020",
    "term": "fallen",
    "meaning": {
      "es": "caer, caerse"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Pass auf, sonst fällst du hin!",
        "translation": "¡Cuidado, o te caes!"
      }
    ],
    "notes": "a → ä en presente: du fällst, er fällt. No es reflexivo: Ich bin gefallen = me caí. Para caerse al suelo se usa mucho hinfallen: Ich bin hingefallen.",
    "tags": [
      "pasado",
      "verbos",
      "irregular"
    ],
    "level": "A2",
    "extra": {
      "present3": "er fällt",
      "perfekt": "ist gefallen",
      "praeteritum": "fiel"
    }
  },
  {
    "id": "de-a2-0021",
    "term": "vorgestern",
    "meaning": {
      "es": "anteayer"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Vorgestern bin ich nach Hamburg gefahren.",
        "translation": "Anteayer fui a Hamburgo."
      }
    ],
    "notes": "gestern = ayer, vorgestern = anteayer, übermorgen = pasado mañana.",
    "tags": [
      "pasado",
      "tiempo"
    ],
    "level": "A2"
  },
  {
    "id": "de-a2-0022",
    "term": "plötzlich",
    "meaning": {
      "es": "de repente"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Plötzlich ist das Licht ausgegangen.",
        "translation": "De repente se fue la luz."
      }
    ],
    "notes": "Muy usado al contar historias. La ö se pronuncia como una e con los labios redondeados.",
    "tags": [
      "pasado",
      "tiempo"
    ],
    "level": "A2"
  },
