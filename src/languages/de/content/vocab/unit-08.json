      "pasado",
      "verbos",
      "irregular",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er schläft ein",
      "perfekt": "ist eingeschlafen",
      "praeteritum": "schlief ein",
      "separable": true
    }
  },
  {
