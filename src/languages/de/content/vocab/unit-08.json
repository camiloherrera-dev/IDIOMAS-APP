    "term": "verlieren",
    "meaning": {
      "es": "perder"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Er hat sein Handy verloren.",
        "translation": "Perdió su celular."
      }
    ],
    "notes": "Participio irregular: verloren. También para partidos: Wir haben das Spiel verloren.",
    "tags": [
      "pasado",
      "verbos",
      "irregular"
    ],
    "level": "A2",
    "extra": {
      "present3": "er verliert",
      "perfekt": "hat verloren",
      "praeteritum": "verlor"
    }
  },
  {
    "id": "de-a2-0006",
    "term": "finden",
    "meaning": {
      "es": "encontrar; parecer (opinión)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Hast du deine Brille gefunden?",
        "translation": "¿Encontraste tus gafas?"
      },
      {
        "text": "Ich finde den Film gut.",
        "translation": "La película me parece buena."
      }
    ],
    "notes": "Dos usos: encontrar algo y dar una opinión (Ich finde…). Irregular: fand, gefunden.",
    "tags": [
      "pasado",
      "verbos",
      "irregular"
    ],
    "level": "A2",
    "extra": {
      "present3": "er findet",
      "perfekt": "hat gefunden",
      "praeteritum": "fand"
    }
  },
  {
    "id": "de-a2-0007",
    "term": "bekommen",
    "meaning": {
      "es": "recibir, conseguir"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich habe eine E-Mail bekommen.",
        "translation": "Recibí un correo."
      }
    ],
    "notes": "Falso amigo: bekommen NO significa 'convertirse' (eso es werden). Prefijo be-: participio sin ge-.",
    "tags": [
      "pasado",
      "verbos",
      "irregular",
      "falso amigo"
    ],
    "level": "A2",
    "extra": {
      "present3": "er bekommt",
      "perfekt": "hat bekommen",
      "praeteritum": "bekam"
    }
  },
  {
    "id": "de-a2-0008",
    "term": "einladen",
    "meaning": {
      "es": "invitar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir haben unsere Freunde eingeladen.",
        "translation": "Invitamos a nuestros amigos."
      },
      {
        "text": "Ich lade dich ein.",
        "translation": "Te invito."
      }
    ],
    "notes": "Separable: ge- va entre el prefijo y la raíz (ein-ge-laden). Presente: du lädst ein, er lädt ein.",
    "tags": [
      "pasado",
      "verbos",
      "irregular",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er lädt ein",
      "perfekt": "hat eingeladen",
      "praeteritum": "lud ein",
      "separable": true
    }
  },
  {
    "id": "de-a2-0009",
    "term": "fotografieren",
    "meaning": {
      "es": "fotografiar, tomar fotos"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Wir haben die Kirche fotografiert.",
        "translation": "Fotografiamos la iglesia."
      }
    ],
    "notes": "Verbos en -ieren: participio sin ge- (fotografiert, studiert, telefoniert).",
    "tags": [
      "pasado",
      "verbos"
    ],
    "level": "A2",
    "extra": {
      "present3": "er fotografiert",
      "perfekt": "hat fotografiert"
    }
  },
  {
    "id": "de-a2-0010",
    "term": "das Erlebnis",
    "meaning": {
      "es": "la experiencia, la vivencia"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Für die Kinder ist der Zoo ein Erlebnis.",
        "translation": "Para los niños, el zoológico es toda una experiencia."
      }
    ],
    "notes": "Neutro. Plural con doble s: die Erlebnisse. Viene de erleben.",
    "tags": [
      "pasado"
    ],
    "level": "A2",
    "extra": {
      "gender": "n",
      "plural": "die Erlebnisse"
    }
  },
  {
    "id": "de-a2-0011",
    "term": "noch nie",
    "meaning": {
      "es": "nunca (hasta ahora)"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Ich habe noch nie Sushi gegessen.",
        "translation": "Nunca he comido sushi."
      }
    ],
    "notes": "Para hablar de experiencias, con Perfekt. Lo contrario: schon einmal / schon mal (alguna vez).",
    "tags": [
      "pasado",
      "expresiones"
    ],
    "level": "A2"
  },
  {
    "id": "de-a2-0012",
    "term": "ankommen",
    "meaning": {
      "es": "llegar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Der Zug ist pünktlich angekommen.",
        "translation": "El tren llegó puntual."
      },
      {
        "text": "Wann kommst du in Berlin an?",
        "translation": "¿Cuándo llegas a Berlín?"
      }
    ],
    "notes": "Separable. Perfekt con sein: es un movimiento de un lugar a otro.",
    "tags": [
      "pasado",
      "verbos",
      "irregular",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er kommt an",
      "perfekt": "ist angekommen",
      "praeteritum": "kam an",
      "separable": true
    }
  },
  {
    "id": "de-a2-0013",
    "term": "abfahren",
    "meaning": {
      "es": "salir, partir (un vehículo o alguien de viaje)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Der Bus ist schon abgefahren.",
        "translation": "El bus ya salió."
      }
    ],
    "notes": "Separable e irregular: du fährst ab, er fährt ab. Perfekt con sein.",
    "tags": [
      "pasado",
      "verbos",
      "irregular",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er fährt ab",
      "perfekt": "ist abgefahren",
      "praeteritum": "fuhr ab",
      "separable": true
    }
  },
  {
    "id": "de-a2-0014",
    "term": "aufwachen",
    "meaning": {
      "es": "despertarse"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich bin um sechs Uhr aufgewacht.",
        "translation": "Me desperté a las seis."
      }
    ],
    "notes": "No es reflexivo en alemán. Cambio de estado: Perfekt con sein. Aufwecken = despertar a otra persona.",
    "tags": [
      "pasado",
      "verbos",
      "separable"
    ],
    "level": "A2",
    "extra": {
      "present3": "er wacht auf",
      "perfekt": "ist aufgewacht",
      "separable": true
    }
  },
  {
    "id": "de-a2-0015",
    "term": "einschlafen",
    "meaning": {
      "es": "dormirse, quedarse dormido"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Das Baby ist sofort eingeschlafen.",
        "translation": "El bebé se durmió enseguida."
      }
    ],
    "notes": "Cambio de estado: sein. En cambio schlafen (dormir) lleva haben: Ich habe gut geschlafen.",
