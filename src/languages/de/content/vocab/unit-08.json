  {
    "id": "de-a2-0018",
    "term": "passieren",
    "meaning": {
      "es": "pasar, ocurrir"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Was ist passiert?",
        "translation": "¿Qué pasó?"
      }
