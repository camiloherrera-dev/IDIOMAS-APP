  {
    "id": "de-a2-0019",
    "term": "umsteigen",
    "meaning": {
      "es": "hacer transbordo, cambiar (de tren o bus)"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "In Köln sind wir umgestiegen.",
        "translation": "En Colonia hicimos transbordo."
      }
    ],
    "notes": "Separable. Familia: einsteigen (subir), aussteigen (bajar), umsteigen (cambiar).",
