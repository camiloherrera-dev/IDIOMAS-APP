  },
  {
    "id": "de-a2-0030",
    "term": "früher",
    "meaning": {
      "es": "antes, antiguamente"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Früher war ich sehr schüchtern.",
        "translation": "Antes era muy tímido."
      }
    ],
    "notes": "Sirve para contrastar pasado y presente: Früher… heute… También es el comparativo de früh.",
    "tags": [
      "pasado",
      "tiempo"
    ],
    "level": "A2"
  },
  {
    "id": "de-a2-0031",
    "term": "als Kind",
    "meaning": {
      "es": "de niño, de niña"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Als Kind wollte ich Pilot werden.",
        "translation": "De niño quería ser piloto."
      }
    ],
    "notes": "Sin artículo: als Kind, als Student. Después viene el verbo en segunda posición: Als Kind hatte ich…",
    "tags": [
      "pasado",
      "expresiones"
    ],
    "level": "A2"
  },
