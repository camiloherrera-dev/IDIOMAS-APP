[
  {
    "id": "de-a2-0001",
    "term": "erleben",
    "meaning": {
      "es": "vivir (una experiencia), experimentar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich habe gestern etwas Lustiges erlebt.",
        "translation": "Ayer me pasó algo divertido."
      }
    ],
    "notes": "Prefijo inseparable er-: el participio no lleva ge- (erlebt).",
    "tags": [
      "pasado",
      "verbos"
    ],
    "level": "A2",
    "extra": {
      "present3": "er erlebt",
      "perfekt": "hat erlebt"
    }
  },
  {
    "id": "de-a2-0003",
    "term": "erzählen",
    "meaning": {
      "es": "contar, narrar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Mein Opa hat eine Geschichte erzählt.",
        "translation": "Mi abuelo contó una historia."
      }
    ],
    "notes": "No confundir con zählen (contar números). Participio sin ge-: erzählt.",
    "tags": [
      "pasado",
      "verbos"
    ],
    "level": "A2",
    "extra": {
      "present3": "er erzählt",
      "perfekt": "hat erzählt"
    }
  },
  {
    "id": "de-a2-0004",
    "term": "vergessen",
    "meaning": {
      "es": "olvidar"
    },
    "pos": "verbo",
    "examples": [
      {
        "text": "Ich habe meinen Schlüssel vergessen.",
        "translation": "Olvidé mi llave."
      },
      {
        "text": "Vergiss das nicht!",
        "translation": "¡No lo olvides!"
      }
    ],
    "notes": "Irregular: e → i en presente (du vergisst, er vergisst). El participio es igual al infinitivo: vergessen.",
    "tags": [
      "pasado",
      "verbos",
      "irregular"
    ],
    "level": "A2",
    "extra": {
      "present3": "er vergisst",
      "perfekt": "hat vergessen",
      "praeteritum": "vergaß"
    }
  },
  {
