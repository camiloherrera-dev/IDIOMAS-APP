    "id": "de-a2-0032",
    "term": "schüchtern",
    "meaning": {
      "es": "tímido"
    },
    "pos": "adjetivo",
    "examples": [
      {
        "text": "Mein Bruder war früher schüchtern.",
        "translation": "Mi hermano antes era tímido."
      }
