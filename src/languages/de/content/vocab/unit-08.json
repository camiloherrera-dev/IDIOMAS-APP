  {
    "id": "de-a2-0029",
    "term": "damals",
    "meaning": {
      "es": "en aquel entonces, en esa época"
    },
    "pos": "adverbio",
    "examples": [
      {
        "text": "Damals hatten wir kein Auto.",
        "translation": "En aquel entonces no teníamos carro."
      }
    ],
    "notes": "Para un momento concreto del pasado. No confundir con dann (luego, después).",
