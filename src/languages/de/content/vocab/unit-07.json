  {
    "id": "de-a1-0289",
    "term": "Wie war dein Wochenende?",
    "meaning": {
      "es": "¿Qué tal tu fin de semana?"
    },
    "pos": "expresión",
    "examples": [
      {
        "text": "Wie war dein Wochenende? Super, danke!",
        "translation": "¿Qué tal tu fin de semana? ¡Genial, gracias!"
      }
    ],
    "notes": "War es el pasado de sein (era, fue, estuvo). Con Sie: Wie war Ihr Wochenende?",
