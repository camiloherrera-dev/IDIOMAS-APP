    "term": "die Party",
    "meaning": {
      "es": "la fiesta"
    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Die Party war toll.",
        "translation": "La fiesta estuvo muy buena."
      }
    ],
    "notes": "Femenino: die. Plural: die Partys. Se pronuncia como en inglés. Para fiestas formales: das Fest.",
