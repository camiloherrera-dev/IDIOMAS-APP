    },
    "pos": "sustantivo",
    "examples": [
      {
        "text": "Das Konzert war super.",
        "translation": "El concierto estuvo genial."
      }
    ],
    "notes": "Neutro: das. Plural: die Konzerte. La z suena 'ts': 'kontsért'.",
