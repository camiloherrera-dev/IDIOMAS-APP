   "sentences": [
    {
     "text": "我 [想] 去 中国。",
     "tr": "Quiero ir a China.",
     "reading": "Wǒ xiǎng qù Zhōngguó."
    },
    {
     "text": "我 [要] 一 杯 水。",
     "tr": "Quiero un vaso de agua.",
     "reading": "Wǒ yào yì bēi shuǐ."
    },
    {
     "text": "你 [会] 说 汉语 吗？",
     "tr": "¿Sabes hablar chino?",
     "reading": "Nǐ huì shuō Hànyǔ ma?"
    },
    {
     "text": "你 明天 [能] 来 吗？",
     "tr": "¿Puedes venir mañana?",
     "reading": "Nǐ míngtiān néng lái ma?"
    },
    {
     "text": "我 [可以] 坐 这儿 吗？",
     "tr": "¿Puedo sentarme aquí?",
     "reading": "Wǒ kěyǐ zuò zhèr ma?"
    },
    {
     "text": "上课 的 时候 [不要] 说话。",
     "tr": "No hablen durante la clase.",
     "reading": "Shàngkè de shíhou búyào shuōhuà."
    },
    {
     "text": "我 不 [会] 开车。",
     "tr": "No sé manejar.",
     "reading": "Wǒ bú huì kāichē."
    }
   ],
   "choices": [
    "想",
    "要",
    "会",
    "能",
    "可以",
    "不要",
    "是"
   ]
