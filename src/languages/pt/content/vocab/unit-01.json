[
  {
    "id": "pt-a1-0001",
    "term": "oi",
    "meaning": { "es": "hola (informal)" },
    "pos": "interjección",
    "examples": [{ "text": "Oi, tudo bem?", "translation": "Hola, ¿todo bien?" }],
    "notes": "Es el saludo más común en Brasil, entre amigos y también con desconocidos.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0002",
    "term": "olá",
    "meaning": { "es": "hola (un poco más formal)" },
    "pos": "interjección",
    "examples": [{ "text": "Olá, bom dia!", "translation": "¡Hola, buenos días!" }],
    "notes": "Lleva tilde en la a final: olá.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0003",
    "term": "bom dia",
    "meaning": { "es": "buenos días" },
    "pos": "expresión",
    "examples": [{ "text": "Bom dia, Ana!", "translation": "¡Buenos días, Ana!" }],
    "notes": "En singular, a diferencia del español. 'Bom' termina en m: la vocal se nasaliza y los labios casi no se cierran.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0004",
    "term": "boa tarde",
    "meaning": { "es": "buenas tardes" },
    "pos": "expresión",
    "examples": [{ "text": "Boa tarde, senhor.", "translation": "Buenas tardes, señor." }],
    "notes": "En singular. 'Tarde' suena aproximadamente 'tarchi' en gran parte de Brasil.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0005",
    "term": "boa noite",
    "meaning": { "es": "buenas noches" },
    "pos": "expresión",
    "examples": [{ "text": "Boa noite, até amanhã!", "translation": "¡Buenas noches, hasta mañana!" }],
    "notes": "Se usa al llegar y al despedirse, igual que en español. 'Noite' suena 'noichi'.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0006",
    "term": "tchau",
    "meaning": { "es": "chao, adiós" },
    "pos": "interjección",
    "examples": [{ "text": "Tchau, até logo!", "translation": "¡Chao, hasta luego!" }],
    "notes": "Se escribe con tch. Es la despedida más común en Brasil.",
    "tags": ["saludos", "despedidas"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0007",
    "term": "até logo",
    "meaning": { "es": "hasta luego" },
    "pos": "expresión",
    "examples": [{ "text": "Até logo, pessoal!", "translation": "¡Hasta luego, gente!" }],
    "notes": "'Até' significa 'hasta'. También se dice: até mais, até amanhã.",
    "tags": ["saludos", "despedidas"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0008",
    "term": "tudo bem?",
    "meaning": { "es": "¿todo bien?, ¿cómo estás?" },
    "pos": "expresión",
    "examples": [{ "text": "Oi, Pedro! Tudo bem? Tudo bem, e você?", "translation": "¡Hola, Pedro! ¿Todo bien? Todo bien, ¿y tú?" }],
    "notes": "Se responde con 'tudo bem' o 'tudo bom'. Es casi automático, como '¿qué más?' en Colombia.",
    "tags": ["saludos"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0009",
    "term": "obrigado",
    "meaning": { "es": "gracias (lo dice un hombre)" },
    "pos": "interjección",
    "examples": [{ "text": "Muito obrigado pela ajuda!", "translation": "¡Muchas gracias por la ayuda!" }],
    "notes": "Una mujer dice: obrigada. Concuerda con quien habla, no con quien escucha.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0010",
    "term": "por favor",
    "meaning": { "es": "por favor" },
    "pos": "expresión",
    "examples": [{ "text": "Um café, por favor.", "translation": "Un café, por favor." }],
    "notes": "Igual que en español.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0011",
    "term": "de nada",
    "meaning": { "es": "de nada" },
    "pos": "expresión",
    "examples": [{ "text": "Obrigada! De nada.", "translation": "¡Gracias! De nada." }],
    "notes": "También se oye 'por nada' o 'imagina'.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0012",
    "term": "desculpa",
    "meaning": { "es": "perdón, disculpa" },
    "pos": "interjección",
    "examples": [{ "text": "Desculpa, eu não entendi.", "translation": "Perdón, no entendí." }],
    "notes": "Más formal: desculpe. También existe 'perdão'.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0013",
    "term": "com licença",
    "meaning": { "es": "con permiso, disculpe (para pasar o interrumpir)" },
    "pos": "expresión",
    "examples": [{ "text": "Com licença, posso passar?", "translation": "Con permiso, ¿puedo pasar?" }],
    "notes": "Se escribe con m y con ç: com licença.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0014",
    "term": "sim",
    "meaning": { "es": "sí" },
    "pos": "adverbio",
    "examples": [{ "text": "Sim, eu sou de Bogotá.", "translation": "Sí, soy de Bogotá." }],
    "notes": "La m final no se pronuncia como m: nasaliza la i. Muchas veces los brasileños responden repitiendo el verbo: 'Você é colombiano? Sou.'",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0015",
    "term": "não",
    "meaning": { "es": "no" },
    "pos": "adverbio",
    "examples": [{ "text": "Não, obrigado.", "translation": "No, gracias." }],
    "notes": "Diptongo nasal ão: suena parecido a 'naun' por la nariz, sin cerrar con n.",
    "tags": ["cortesía"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0016",
    "term": "muito prazer",
    "meaning": { "es": "mucho gusto" },
    "pos": "expresión",
    "examples": [{ "text": "Muito prazer! O prazer é meu.", "translation": "¡Mucho gusto! El gusto es mío." }],
    "notes": "'Muito' se pronuncia con nasal: 'muinto'. 'Prazer' es masculino.",
    "tags": ["presentaciones"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0017",
    "term": "eu",
    "meaning": { "es": "yo" },
    "pos": "pronombre",
    "examples": [{ "text": "Eu sou colombiano.", "translation": "Yo soy colombiano." }],
    "notes": "En Brasil el pronombre sujeto se dice mucho más que en español.",
    "tags": ["pronombres"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0018",
    "term": "você",
    "meaning": { "es": "tú, usted" },
    "pos": "pronombre",
    "examples": [{ "text": "Você é brasileiro?", "translation": "¿Eres brasileño?" }],
    "notes": "En Brasil 'você' es la forma normal para tratar a alguien. El verbo va en tercera persona: você é, você fala. Para mucho respeto: o senhor, a senhora.",
    "tags": ["pronombres"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0019",
    "term": "meu nome é",
    "meaning": { "es": "mi nombre es, me llamo" },
    "pos": "expresión",
    "examples": [{ "text": "Meu nome é Camilo.", "translation": "Mi nombre es Camilo." }],
    "notes": "'Meu' (mi) es para sustantivos masculinos; para femeninos se usa 'minha': minha mãe.",
    "tags": ["presentaciones"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0020",
    "term": "me chamo",
    "meaning": { "es": "me llamo" },
    "pos": "expresión",
    "examples": [{ "text": "Eu me chamo Camilo.", "translation": "Me llamo Camilo." }],
    "notes": "Viene del verbo chamar-se. En Brasil el pronombre va antes del verbo: 'Eu me chamo', 'Como você se chama?'",
    "tags": ["presentaciones"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0021",
    "term": "como",
    "meaning": { "es": "cómo" },
    "pos": "adverbio",
    "examples": [{ "text": "Como você se chama?", "translation": "¿Cómo te llamas?" }],
    "notes": "En portugués no lleva tilde ni en preguntas: como.",
    "tags": ["preguntas"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0022",
    "term": "de onde",
    "meaning": { "es": "de dónde" },
    "pos": "expresión",
    "examples": [{ "text": "De onde você é?", "translation": "¿De dónde eres?" }],
    "notes": "'Onde' es 'dónde'. Sin tilde.",
    "tags": ["preguntas", "presentaciones"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0023",
    "term": "colombiano",
    "meaning": { "es": "colombiano" },
    "pos": "adjetivo",
    "examples": [{ "text": "Eu sou colombiano, de Medellín.", "translation": "Soy colombiano, de Medellín." }],
    "notes": "Femenino: colombiana. La o final átona suena casi como u: 'colombianu'.",
    "tags": ["nacionalidades"],
    "level": "A1",
    "extra": { "falseFriend": false }
  },
  {
    "id": "pt-a1-0024",
    "term": "brasileiro",
    "meaning": { "es": "brasileño" },
    "pos": "adjetivo",
    "examples": [{ "text": "Ela é brasileira, do Rio.", "translation": "Ella es brasileña, de Río." }],
    "notes": "Femenino: brasileira. La terminación -eño del español muchas veces corresponde a -eiro en portugués.",
    "tags": ["nacionalidades"],
    "level": "A1",
    "extra": { "falseFriend": false }
  }
]
