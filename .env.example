# Copia este archivo como .env.local (no se sube a git)

# Cadena de conexión de Neon (https://console.neon.tech → tu proyecto → Connect).
# Solo la usa el servidor (api/sync.ts). NUNCA le pongas el prefijo VITE_.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Opcional: URL completa de la API si la app se sirve desde otro dominio (p. ej. GitHub Pages)
# VITE_SYNC_URL=https://tu-proyecto.vercel.app/api/sync

# Opcional: orígenes permitidos para la API, separados por coma (por defecto *)
# ALLOWED_ORIGINS=https://camiloherrera-dev.github.io
