# Copia este archivo como .env.local para usar una base real en local (no se sube a git).
# En Vercel estas variables van en Settings → Environment Variables.

# Base de datos Neon. Si la creas desde Vercel (pestaña Storage → Neon), Vercel la agrega sola.
# Solo la usa el servidor. NUNCA le pongas el prefijo VITE_.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Firma las sesiones. 32 caracteres aleatorios o más; genera uno con:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Opcional: URL pública de la app. Si no se pone, se usa la de producción de Vercel.
# Hace falta si usas un dominio propio.
# BETTER_AUTH_URL=https://lingo-lab.vercel.app

# Opcional: "Continuar con Google" (Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth).
# URI de redirección autorizado: https://<tu-app>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Opcional: otros orígenes permitidos, separados por coma (por ejemplo un dominio propio)
# ALLOWED_ORIGINS=https://lingo.midominio.com

# Solo para la versión de GitHub Pages: enlace a la versión con cuentas
# VITE_APP_URL=https://lingo-lab.vercel.app
